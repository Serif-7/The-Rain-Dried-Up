<Project>

  <!-- The same submodule check as Directory.Build.targets, for a build of the solution: its restore reaches the engine's projects first. -->
  <Target Name="MeitouCheckSubmodules" BeforeTargets="Restore;_LoadRestoreGraphEntryPoints;Build"
    Condition="!Exists('$(MSBuildThisFileDirectory)engine/Directory.Build.props')">
    <Error Code="MEITOU001" Text="This clone is missing its engine submodule. In the repository's folder run: git submodule update --init" />
  </Target>

</Project>
