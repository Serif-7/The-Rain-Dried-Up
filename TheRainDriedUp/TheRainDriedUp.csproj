<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Rain Dried Up's code mod: its characters' records (added in the data phase) and the F10 recruit window. Built against the game's
    assemblies, never copied: the game loads them. The bodies in items/races are copied by Play.
  -->

  <PropertyGroup>
    <AssemblyName>TheRainDriedUp</AssemblyName>
    <RootNamespace>TheRainDriedUp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Core/Meitou.Core.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Data/Meitou.Data.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Simulation/Meitou.Simulation.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Game/Meitou.Game.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheRainDriedUp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="meitou.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
